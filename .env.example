# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for verified provider webhooks, scheduled jobs and storage health checks. Never expose.
SUPABASE_SECRET_KEY=

# ---- Phase 2 integrations (leave empty until official docs are provided) ----
# Telephony provider key, e.g. "sarvam" or "exotel". Empty = live calling disabled.
TELEPHONY_PROVIDER=
SARVAM_API_KEY=
TELEPHONY_WEBHOOK_SECRET=
# Shared secret for /api/cron/campaigns (scheduled campaign processing)
CRON_SECRET=
